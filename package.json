{
  "name": "sdlc-manager",
  "version": "1.0.0",
  "private": true,
  "description": "A desktop dashboard that reads agentic SDLC lifecycles from the agent packages that execute them.",
  "type": "module",
  "main": "dist/main.cjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:renderer && npm run build:main && npm run build:preload",
    "build:renderer": "vite build",
    "build:main": "vite build --config electron.vite.config.ts",
    "build:preload": "vite build --config preload.vite.config.ts",
    "package": "npm run build && electron-builder",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "size": "size-limit",
    "smoke": "node scripts/smoke.mjs",
    "fixture:create": "node scripts/fixture.ts create",
    "fixture:package": "node scripts/fixture.ts package",
    "fixture:fail": "node scripts/fixture.ts fail",
    "fixture:upgrade": "node scripts/fixture.ts upgrade",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build && npm run size && npm run smoke"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@tanstack/react-query": "^5.66.0",
    "chokidar": "^4.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.3",
    "react-router": "^7.1.5",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.50.1",
    "@size-limit/file": "^11.1.6",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.1.1",
    "electron-builder": "^25.1.8",
    "eslint": "^9.20.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^15.14.0",
    "jsdom": "^26.0.0",
    "size-limit": "^11.1.6",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.23.0",
    "vite": "^6.1.0",
    "vitest": "^3.2.0",
    "vitest-axe": "^1.0.0-pre.3"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "electron@34.5.8": true
  }
}
